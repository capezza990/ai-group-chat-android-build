@@ -0,0 +1,42 @@
+package com.aigroupchat.bridge.room;
+
+import java.util.Locale;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/** Hidden control line used only by natural multi-AI conversation. It never becomes canonical room text. */
+public final class CollaborationControl {
+    public enum Signal { CONTINUE, DONE, USER, MISSING }
+
+    private static final Pattern PATTERN = Pattern.compile(
+            "(?im)^[\\t \\u00A0]*\\[\\[(CONTINUE|NEXT:USER|DONE)\\]\\][\\t \\u00A0]*$" );
+
+    private CollaborationControl() {}
+
+    public static Signal signal(String text) {
+        Matcher m = PATTERN.matcher(text == null ? "" : text);
+        String token = null;
+        while (m.find()) token = m.group(1);
+        if (token == null) return Signal.MISSING;
+        switch (token.toUpperCase(Locale.US)) {
+            case "DONE": return Signal.DONE;
+            case "NEXT:USER": return Signal.USER;
+            case "CONTINUE": return Signal.CONTINUE;
+            default: return Signal.MISSING;
+        }
+    }
+
+    public static String clean(String text) {
+        return PATTERN.matcher(text == null ? "" : text)
+                .replaceAll("")
+                .replaceAll("\\n{3,}", "\\n\\n")
+                .trim();
+    }
+
+    public static String instruction() {
+        return "ROOM TURN CONTROL (required, hidden from the user): At the very end of your response, on its own line, "
+                + "write exactly one marker. Use [[CONTINUE]] only if another AI turn would materially help the shared task; "
+                + "use [[NEXT:USER]] if useful work now requires the user to answer, choose, approve, test, or provide something; "
+                + "use [[DONE]] when the shared task is complete or another AI turn would only repeat/agreement. Do not explain the marker.";
+    }
+}
