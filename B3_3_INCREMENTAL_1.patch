index 0000000..d20ea00
--- /dev/null
+++ b/app/src/main/java/com/aigroupchat/bridge/room/ArtifactReferenceResolver.java
@@ -0,0 +1,53 @@
+package com.aigroupchat.bridge.room;
+
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.regex.Pattern;
+
+/**
+ * Conservative resolver for OLD room files. Historical bytes are lazy: merely being in canonical history does not upload
+ * them into every AI thread. We only choose an old artifact when the current user request clearly refers to a file.
+ * Current-turn attachments are handled separately by ArtifactGate and never need this resolver.
+ */
+public final class ArtifactReferenceResolver {
+    private static final Pattern GENERIC_REFERENCE = Pattern.compile(
+            "(?i)\\b(?:that|the|this|those|these|previous|earlier|last|old|same|attached|uploaded|sent|shared)\\s+"
+          + "(?:image|images|photo|photos|picture|pictures|screenshot|screenshots|file|files|attachment|attachments|document|documents|pdf|pdfs|spreadsheet|spreadsheets|zip|zips)\\b"
+          + "|\\b(?:image|photo|picture|screenshot|file|attachment|document|pdf|spreadsheet|zip)\\s+(?:i|we)\\s+(?:sent|shared|uploaded|attached)\\b");
+
+    private ArtifactReferenceResolver() { }
+
+    /** Returns artifact ids in canonical order. Exact filename mention wins; otherwise a clear generic reference selects the newest historical attachment message. */
+    public static Set<String> select(String requestText, List<AttachedArtifact> historical) {
+        LinkedHashSet<String> out = new LinkedHashSet<>();
+        if (historical == null || historical.isEmpty()) return out;
+        String q = requestText == null ? "" : requestText.toLowerCase(Locale.US);
+
+        // Exact names are unambiguous. Prefer only the newest message containing that name so a repeated filename does not resurrect every old copy.
+        long newestExactSeq = -1L;
+        for (int i = historical.size() - 1; i >= 0; i--) {
+            AttachedArtifact aa = historical.get(i);
+            String name = aa.artifact.displayName == null ? "" : aa.artifact.displayName.trim().toLowerCase(Locale.US);
+            if (name.length() < 2 || !q.contains(name)) continue;
+            if (newestExactSeq < 0) newestExactSeq = aa.messageSeq;
+            if (aa.messageSeq == newestExactSeq) out.add(aa.artifact.id);
+        }
+        if (!out.isEmpty()) return out;
+
+        if (!GENERIC_REFERENCE.matcher(requestText == null ? "" : requestText).find()) return out;
+        long newestSeq = historical.get(historical.size() - 1).messageSeq;
+        for (AttachedArtifact aa : historical) if (aa.messageSeq == newestSeq) out.add(aa.artifact.id);
+        return out;
+    }
+
+    /** Test helper / prompt helper: filters a canonical attachment list to selected ids without changing order. */
+    static List<AttachedArtifact> filter(List<AttachedArtifact> in, Set<String> ids) {
+        List<AttachedArtifact> out = new ArrayList<>();
+        if (in == null || ids == null || ids.isEmpty()) return out;
+        for (AttachedArtifact a : in) if (ids.contains(a.artifact.id)) out.add(a);
+        return out;
+    }
+}
