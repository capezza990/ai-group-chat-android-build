+  // Some providers (currently ChatGPT) use an exact named file control to open a viewer, then expose the real download in that viewer.
+  // This is called only while native capture is armed. It clicks nothing unless the provider configured an exact selector and that selector
+  // currently resolves to exactly one BUTTON. A missing viewer is "not-ready" so the app can retry briefly; ambiguity fails closed.
+  function clickAfterOfferDownload() {
+    var sels = spec().afterClickDownloadButton || [];
+    if (!sels.length) return JSON.stringify({ ok: false, error: 'not-configured' });
+    for (var i = 0; i < sels.length; i++) {
+      var found;
+      try { found = document.querySelectorAll(sels[i]); } catch (e) { continue; }
+      if (!found || found.length === 0) continue;
+      if (found.length !== 1) return JSON.stringify({ ok: false, error: 'ambiguous' });
+      var el = found[0];
+      if (!el || String(el.tagName || '').toLowerCase() !== 'button') return JSON.stringify({ ok: false, error: 'not-button' });
+      try { el.click(); } catch (e) { return JSON.stringify({ ok: false, error: 'click-failed' }); }
+      return JSON.stringify({ ok: true });
+    }
+    return JSON.stringify({ ok: false, error: 'not-ready' });
+  }
+
